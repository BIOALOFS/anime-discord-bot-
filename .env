# Discord application bot token (never commit the real value)
DISCORD_TOKEN=
DATABASE_URL=sqlite+aiosqlite:////data/anpot.db
# TMDB v4 Read Access Token. TMDB features remain unavailable when empty.
TMDB_API_TOKEN=
DEFAULT_LANGUAGE=ar
COMMAND_PREFIX=!
TRUSTED_USERS_FILE=trusted_users.json
# Optional guild for instant development command sync; omit for global sync.
DISCORD_TEST_GUILD_ID=
HTTP_USER_AGENT=AnpotBot/1.0 (contact@example.com)
PROVIDER_CACHE_TTL=900
MAX_IMAGE_BYTES=8388608

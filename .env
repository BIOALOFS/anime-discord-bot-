DISCORD_TOKEN=
DATABASE_URL=sqlite://bot.db?mode=rwc
LOG_LEVEL=info
ANILIST_RATE_LIMIT_PER_MIN=25
CACHE_TTL_SEARCH_SECS=600
CACHE_TTL_DETAILS_SECS=21600
CACHE_TTL_PROFILE_SECS=900
CACHE_TTL_AIRING_SECS=300
CACHE_TTL_NEGATIVE_SECS=300
# Optional: register commands instantly in one guild during development
DEV_GUILD_ID=
COMMAND_COOLDOWN_SECS=3
# Optional: MangaDex / MangaUpdates fallback for works AniList lacks (off by default)
ENABLE_FALLBACK_PROVIDERS=false
# Optional: IGDB games and game characters (non-commercial use). Get both at https://dev.twitch.tv/console
# (application type Confidential, OAuth Redirect URL http://localhost, Twitch account with 2FA). Leave empty to disable.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# Optional: VNDB visual novels (no key needed). Set to false to disable.
ENABLE_VNDB=true
# Optional: TMDB for dramas, series and films. Key from https://www.themoviedb.org/settings/api (or the read token).
TMDB_API_KEY=
TMDB_READ_TOKEN=
# Region of the "where to watch" data, and a master switch.
TMDB_REGION=OM
ENABLE_TMDB=true
TMDB_RATE_LIMIT_PER_10S=30
